  m_text: "\u0412\u043E \u0438\u043C\u044F \u0447\u0435\u0441\u0442\u0438 \u0438
    \u0441\u043B\u0430\u0432\u044B!\n\n\u0417\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C
    \u0441\u0435\u0433\u043E \u043C\u0438\u0440\u0430 \u0441\u0442\u043E\u044F\u0442
    \u0442\u0435, \u043A\u0442\u043E \u043E\u0441\u043C\u0435\u043B\u0438\u043B\u0441\u044F
    \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u044B\u0437\u043E\u0432 \u043F\u0443\u0441\u0442\u043E\u0442\u0435
    \u0438 \u0432\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u0436\u0438\u0437\u043D\u044C
    \u0432 \u0441\u0442\u0440\u043E\u043A\u0438 \u043A\u043E\u0434\u0430.\n\n\u041C\u044B
    \u2014 \u043C\u0430\u0441\u0442\u0435\u0440\u0430 \u0441\u0432\u043E\u0435\u0433\u043E
    \u0440\u0435\u043C\u0435\u0441\u043B\u0430, \u0442\u0432\u043E\u0440\u0446\u044B
    \u0446\u0438\u0444\u0440\u043E\u0432\u044B\u0445 \u0437\u0435\u043C\u0435\u043B\u044C
    \u0438 \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0438 \u0438\u0433\u0440\u043E\u0432\u044B\u0445
    \u043C\u0438\u0440\u043E\u0432. \u0414\u043E\u043B\u0433\u0438\u043C\u0438 \u043D\u043E\u0447\u0430\u043C\u0438,
    \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0432\u0430\u044F \u0431\u0430\u0433\u0438,
    \u043E\u0448\u0438\u0431\u043A\u0438 \u0438 \u043F\u0440\u043E\u0447\u0438\u0435
    \u043D\u0430\u043F\u0430\u0441\u0442\u0438, \u043C\u044B \u043A\u043E\u0432\u0430\u043B\u0438
    \u0441\u0438\u0435 \u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435.\n\n\u041F\u0443\u0441\u0442\u044C
    \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u0438\u043A\u0441\u0435\u043B\u044C
    \u0441\u0438\u044F\u0435\u0442, \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C
    \u0441\u043B\u0443\u0436\u0438\u0442 \u0432\u0435\u0440\u043D\u043E, \u0430 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
    \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0437\u043D\u0430\u044E\u0442
    \u043A\u043E\u043D\u0446\u0430!\n\n\u0414\u0430 \u043F\u0440\u0435\u0431\u0443\u0434\u0435\u0442
    \u0441 \u0432\u0430\u043C\u0438 \u0447\u0435\u0441\u0442\u044C, \u043E\u0442\u0432\u0430\u0433\u0430
    \u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u0439 FPS!\n\n\u0421 \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0435\u043C,
    \u041E\u0440\u0434\u0435\u043D \u0421\u043E\u0437\u0434\u0430\u0442\u0435\u043B\u0435\u0439."
